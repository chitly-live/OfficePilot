{
  "name": "officepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "node dist/worker/worker/index.js",
    "worker:dev": "tsx worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.96.0",
