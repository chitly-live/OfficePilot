// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  /// Read-only Finance access: every finance page + report download, no writes,
  /// no other module. Meant for the external accountant.
  ACCOUNTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK_AD
  GOOGLE_AD
  INSTAGRAM
  REFERRAL
  MANUAL
  OTHER
}

enum CampaignChannel {
  META_ADS
  GOOGLE_ADS
  INSTAGRAM_ORGANIC
  YOUTUBE
  INFLUENCER
  EMAIL
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
  YOUTUBE
  THREADS
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum DevTaskStatus {
  TODO
  DOING
  DONE
}

enum DevTaskType {
  FEATURE
  BUG
  CHORE
  RELEASE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(EMPLOYEE)
  phone             String?
  designation       String?
  joinedAt          DateTime  @default(now())
  isActive          Boolean   @default(true)
  avatarUrl         String?
  // Per-module access list for EMPLOYEE role users (v0.1.3 / FEATURE-A).
  // Empty array = legacy/default = all employee-accessible modules visible
  // (backward compat). Admins ignore this field — they always see all
  // modules. Module IDs: 'dashboard', 'employees', 'leads', 'marketing',
  // 'social', 'dev'. ('ai' and 'settings/users' are admin-only regardless.)
  moduleAccess      String[]  @default([])
  // Set whenever the password changes (self-service reset or admin edit).
  // The JWT callback compares it with the session's sign-in time so a
  // password reset signs every other device out within ~5 minutes.
  passwordChangedAt DateTime?
  /// Agreed monthly pay (salary or stipend), INR. Admin-only field; used by
  /// the Finance module to show paid / pending per month.
  monthlySalary     Float?
  /// Free label shown next to the amount, e.g. "Intern stipend", "Salary".
  salaryLabel       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedLeads          Lead[]               @relation("LeadOwner")
  createdLeads        Lead[]               @relation("LeadCreator")
  campaigns           Campaign[]
  socialPosts         SocialPost[]
  devTasks            DevTask[]            @relation("TaskAssignee")
  reportedBugs        DevTask[]            @relation("TaskReporter")
  notes               Note[]
  activities          ActivityLog[]
  attendance          Attendance[]
  financeParties      FinanceParty[]       @relation("FinancePartyCreator")
  financeTransactions FinanceTransaction[] @relation("FinanceTransactionCreator")
  gstReturns          GstReturn[]          @relation("GstReturnCreator")
  passwordResetTokens PasswordResetToken[]
  /// The Finance party that represents this employee (salary payouts).
  financeParty        FinanceParty?        @relation("FinancePartyUser")
  /// Assets this user created / is holding / handed over.
  assetsCreated       Asset[]              @relation("AssetCreator")
  assetsHeld          AssetAssignment[]    @relation("AssetHolderUser")
  assetMoves          AssetAssignment[]    @relation("AssetAssignmentCreator")
  monthsClosed        MonthClose[]         @relation("MonthCloseCreator")
}

/// A product / business line under the company (e.g. Chitly, Arrows Go).
/// Company-level things (employees, bank, cards, salary) are shared; ledger
/// rows carry `productId` so income / expense can be sliced per product.
/// `productId = null` on a row means "company-level".
model Product {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String? // hex accent for badges
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinanceTransaction[]
  assets       Asset[]

  @@index([isActive, sortOrder])
}

/// One "forgot password" link. Only the SHA-256 of the emailed token is
/// stored, so a database leak cannot be replayed. Single use, 30-minute
/// expiry, newest link invalidates older ones (see src/lib/password-reset-service.ts).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Lead {
  id       String     @id @default(cuid())
  name     String
  phone    String?
  email    String?
  company  String?
  city     String?
  source   LeadSource @default(MANUAL)
  status   LeadStatus @default(NEW)
  priority Priority   @default(MEDIUM)
  value    Float? // estimated value in INR
  notes    String?    @db.Text
  tags     String[]   @default([])

  // v0.1.4 — fields matching Chitly team's existing lead spreadsheet
  // format (see Excel screenshot). All optional so older imports without
  // these columns continue to work. `address` is free-form multi-line
  // (replaces narrow `city` for new leads but city kept for back-compat).
  age           Int?
  activeSince   String? // e.g. "5 Days", "6 months" — free text
  languages     String[] @default([]) // e.g. ["Hindi", "Marathi", "English"]
  extraDetails  String?  @db.Text // short context line, separate from `notes`
  phoneType     String? // "iPhone" | "Android" | "Other" | null
  notOnWhatsapp Boolean  @default(false)
  address       String?  @db.Text // full address — city + state + country if needed

  ownerId     String?
  owner       User?   @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User    @relation("LeadCreator", fields: [createdById], references: [id])

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  nextFollowUpAt DateTime?
  convertedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ActivityLog[]

  @@index([status])
  @@index([ownerId])
  @@index([source])
  @@index([nextFollowUpAt])
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  channel     CampaignChannel
  status      CampaignStatus  @default(DRAFT)
  startDate   DateTime
  endDate     DateTime?
  budget      Float // INR
  spent       Float           @default(0)
  impressions Int             @default(0)
  clicks      Int             @default(0)
  signups     Int             @default(0)
  conversions Int             @default(0)
  notes       String?         @db.Text

  utmSource   String?
  utmMedium   String?
  utmCampaign String? @unique

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([channel])
  @@index([startDate])
}

model SocialPost {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  status      PostStatus     @default(DRAFT)
  caption     String         @db.Text
  mediaUrls   String[]       @default([])
  hashtags    String[]       @default([])
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String? // platform post id
  externalUrl String?

  // performance (manually entered or pulled by job)
  likes       Int @default(0)
  comments    Int @default(0)
  shares      Int @default(0)
  reach       Int @default(0)
  impressions Int @default(0)

  isWinner Boolean @default(false) // marked as top performer

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
}

model DevTask {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  type        DevTaskType   @default(FEATURE)
  status      DevTaskStatus @default(TODO)
  priority    Priority      @default(MEDIUM)

  // for bugs
  affectsVersion   String?
  stepsToReproduce String? @db.Text

  // for releases
  releaseVersion String?
  releasedAt     DateTime?
  platform       String? // "iOS" | "Android" | "Web"

  // roadmap horizon (target week)
  targetWeek DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporterId String
  reporter   User    @relation("TaskReporter", fields: [reporterId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([type])
  @@index([assigneeId])
  @@index([targetWeek])
}

model Note {
  id         String   @id @default(cuid())
  body       String   @db.Text
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  entityType String // "lead" | "campaign" | "devtask"
  entityId   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model ActivityLog {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  action     String // "lead.created", "lead.status_changed", "campaign.spent_updated", etc.
  entityType String
  entityId   String
  metadata   Json?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Attendance {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime @db.Date
  status String // "present" | "leave" | "wfh" | "absent"
  notes  String?

  @@unique([userId, date])
  @@index([date])
}

model AIInsight {
  id          String   @id @default(cuid())
  generatedAt DateTime @default(now())
  periodStart DateTime
  periodEnd   DateTime
  // Scopes added in v0.1.3: "predictions" (forecast), "anomalies" (spike/drop alerts).
  scope       String // "ads" | "social" | "leads" | "overall" | "predictions" | "anomalies"
  trend       String // "up" | "down" | "flat"
  trendPct    Float?
  summary     String   @db.Text
  suggestion  String   @db.Text
  rawData     Json // snapshot of metrics used
  tokenUsage  Int?

  @@index([scope])
  @@index([generatedAt])
}

/// Claude-generated prioritized action items (v0.1.3 Theme 5).
/// Generated by /api/ai/actions/generate from the latest AIInsight rows;
/// admin marks DONE/DISMISSED as they action or triage them.
model AIAction {
  id              String    @id @default(cuid())
  generatedAt     DateTime  @default(now())
  priority        String // "HIGH" | "MEDIUM" | "LOW"
  scope           String // which insight scope produced it: "ads" | "social" | "leads" | "overall" | "predictions" | "anomalies"
  title           String
  rationale       String    @db.Text
  // "OPEN" (default) | "DONE" (admin actioned) | "DISMISSED" (not relevant).
  status          String    @default("OPEN")
  // Set when status moves to DONE or DISMISSED.
  resolvedAt      DateTime?
  resolvedById    String?
  // Optional link back to the AIInsight that surfaced this action.
  sourceInsightId String?
  metadata        Json?

  @@index([priority, status])
  @@index([status, generatedAt])
}

model Setting {
  key   String @id
  value String @db.Text
}

// ---------------------------------------------------------------------------
// Finance module (v0.1.5) — income / expense ledger, parties, accounts.
// ---------------------------------------------------------------------------

/// Cash-flow direction of a ledger row. IN = money came in, OUT = money went out.
enum FinanceDirection {
  IN
  OUT
}

/// Who we transact with. FINANCER lends money (loan), CARD_OWNER lends their
/// credit card (we owe them what we spend on it), WORKER is a host/employee
/// who withdraws earnings, VENDOR is a supplier (Facebook Ads, ZeroCloud, CA),
/// CLIENT pays us.
enum FinancePartyType {
  FINANCER
  CARD_OWNER
  WORKER
  VENDOR
  CLIENT
  /// One of our own panel users — salary / stipend. Linked via `userId`.
  EMPLOYEE
  /// Someone money merely passes through (e.g. a friend whose bank account
  /// forwards a payment). Used with `FinanceTransaction.viaPartyId`.
  INTERMEDIARY
  OTHER
}

/// Payment instrument a transaction moved through.
enum FinanceAccountType {
  BANK
  CASH
  UPI
  CREDIT_CARD
  WALLET
  OTHER
}

/// Ledger category. Each category belongs to exactly one direction and is
/// either OPERATING (counts in income / expense) or FINANCING (loan in/out,
/// card settlement — moves cash but is not P&L). See `src/lib/finance.ts`.
enum FinanceCategory {
  // IN
  SALES
  SERVICE_INCOME
  LOAN_RECEIVED
  INVESTMENT_RECEIVED
  REFUND_RECEIVED
  OTHER_INCOME
  // OUT
  ADS
  SOFTWARE
  PAYOUT
  SALARY
  PROFESSIONAL_FEES
  LOAN_REPAYMENT
  CARD_REPAYMENT
  RENT
  UTILITIES
  OFFICE
  /// Something bought that we still own — laptop, phone, furniture, a domain.
  /// Capital, so it moves cash but never lands in the P&L expense figure.
  ASSET_PURCHASE
  TRAVEL
  TAX
  BANK_CHARGES
  OTHER_EXPENSE
}

model FinanceParty {
  id       String           @id @default(cuid())
  name     String
  type     FinancePartyType @default(OTHER)
  phone    String?
  email    String?
  notes    String?          @db.Text
  isActive Boolean          @default(true)

  /// Set when the party IS one of our panel users (type EMPLOYEE): salary
  /// payouts recorded against this party show up on the employee's page.
  userId String? @unique
  user   User?   @relation("FinancePartyUser", fields: [userId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("FinancePartyCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           FinanceAccount[]
  transactions       FinanceTransaction[] @relation("FinanceTransactionParty")
  /// Transactions where this party was only the intermediary the bank paid
  /// (money passed through them to the real `party`). Not part of balances.
  routedTransactions FinanceTransaction[] @relation("FinanceTransactionVia")
  /// Assets this party has held (a worker's phone, a vendor's repair).
  assetsHeld         AssetAssignment[]    @relation("AssetHolderParty")

  @@index([type])
  @@index([name])
}

model FinanceAccount {
  id             String             @id @default(cuid())
  name           String
  type           FinanceAccountType @default(BANK)
  /// Set when the instrument belongs to someone else (e.g. a lent credit
  /// card). Every OUT transaction through it becomes money we owe the owner.
  ownerPartyId   String?
  ownerParty     FinanceParty?      @relation(fields: [ownerPartyId], references: [id], onDelete: Restrict)
  openingBalance Float              @default(0) // INR
  isActive       Boolean            @default(true)
  notes          String?

  /// Credit cards only: sanctioned limit, statement generation day (1–31)
  /// and payment due day (1–31, first occurrence after the statement).
  creditLimit Float?
  billingDay  Int?
  dueDay      Int?

  /// Bank accounts only: the average monthly balance the bank expects. Fall
  /// below it and they levy a non-maintenance charge plus GST.
  requiredAmb Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinanceTransaction[]      @relation("FinanceTransactionAccount")
  /// Card repayments that settle this card's bill (`settlesAccountId`).
  settlements  FinanceTransaction[]      @relation("FinanceTransactionSettles")
  /// Shares of a repayment that cleared this card (one payment, many cards).
  allocations  CardRepaymentAllocation[]
  gstReturns   GstReturn[]
  /// Balance recorded each time a month containing this account was closed.
  closings     MonthCloseBalance[]

  @@index([type])
  @@index([ownerPartyId])
}

model FinanceTransaction {
  id               String           @id @default(cuid())
  date             DateTime // day of the transaction (UTC midnight)
  direction        FinanceDirection
  category         FinanceCategory
  amount           Float // INR, always positive
  /// Optional foreign-currency origin, e.g. 299 USD that cost ₹29,722.
  originalAmount   Float?
  originalCurrency String? // ISO-4217, e.g. "USD"
  description      String?
  reference        String? // UTR / txn id / invoice no
  dueDate          DateTime? // e.g. when a loan is due back

  /// The real counterparty — who the money is ultimately for / from. Drives
  /// every balance ("we owe", paid to, received from).
  partyId          String?
  party            FinanceParty?   @relation("FinanceTransactionParty", fields: [partyId], references: [id], onDelete: Restrict)
  /// Optional intermediary the bank actually paid, when money was routed
  /// (e.g. bank → Ritu → Shubham). Matches the bank narration; never
  /// affects balances.
  viaPartyId       String?
  viaParty         FinanceParty?   @relation("FinanceTransactionVia", fields: [viaPartyId], references: [id], onDelete: Restrict)
  accountId        String?
  account          FinanceAccount? @relation("FinanceTransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  /// For CARD_REPAYMENT rows: which credit card's bill this payment settles.
  /// Reduces that card's outstanding / frees its limit. The party balance
  /// ("we owe the card owner") is unaffected — that is driven by `partyId`.
  settlesAccountId String?
  settlesAccount   FinanceAccount? @relation("FinanceTransactionSettles", fields: [settlesAccountId], references: [id], onDelete: Restrict)
  /// Which product this row belongs to; null = company-level (Praxxel).
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("FinanceTransactionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set on the two TAX rows a monthly GST return generates.
  gstReturnAsCash GstReturn?                @relation("GstReturnCash")
  gstReturnAsItc  GstReturn?                @relation("GstReturnItc")
  /// Per-card split when ONE payment clears more than one card. The ledger
  /// row always mirrors the bank statement line; the split lives here.
  cardAllocations CardRepaymentAllocation[]
  /// Set when this row paid for something we still own.
  asset           Asset?

  @@index([date])
  @@index([direction])
  @@index([category])
  @@index([partyId])
  @@index([viaPartyId])
  @@index([accountId])
  @@index([settlesAccountId])
  @@index([productId])
}

/// How much of one repayment went to which card.
///
/// A bank transfer is a single line on the statement, so the ledger keeps a
/// single `FinanceTransaction` for it. When that one transfer clears two or
/// more card bills, each share is recorded here instead of splitting the
/// payment — the statement and the ledger stay line-for-line identical.
///
/// `FinanceTransaction.settlesAccountId` remains the shortcut for the common
/// single-card case; card positions count both, never the same rupee twice.
model CardRepaymentAllocation {
  id            String             @id @default(cuid())
  transactionId String
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       FinanceAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// INR share of the parent payment. All shares must sum to <= the payment.
  amount        Float
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transactionId, accountId])
  @@index([accountId])
}

/// One GST return per month (GSTR-3B). The accountant records how the
/// liability was settled: input tax credit (no cash) + cash paid. Saving
/// writes / updates two TAX rows in the ledger — the cash part against the
/// chosen account, the ITC part with no account — so the Government (GST)
/// party shows the full amount while cash balances stay honest.
model GstReturn {
  id    String @id @default(cuid())
  /// `YYYY-MM` — the tax period the return covers.
  month String @unique

  /// Totals across the three tax heads. Kept denormalised because the
  /// ledger rows, the ITC balance and every report read these.
  ///
  /// Input tax credit claimed this period from purchase bills (INR). Adds to
  /// the credit ledger; no cash moves and no ledger row is written.
  itcClaimed Float @default(0)
  /// Portion of the liability set off against input tax credit (INR).
  itcUsed    Float @default(0)
  /// Portion paid in cash through the GST portal (INR).
  cashPaid   Float @default(0)

  /// Head-wise split as filed in GSTR-3B. IGST for inter-state, CGST + SGST
  /// (usually equal halves) for intra-state. Each total above is the sum of
  /// its three heads whenever the accountant fills them in.
  itcClaimedIgst Float @default(0)
  itcClaimedCgst Float @default(0)
  itcClaimedSgst Float @default(0)
  itcUsedIgst    Float @default(0)
  itcUsedCgst    Float @default(0)
  itcUsedSgst    Float @default(0)
  cashPaidIgst   Float @default(0)
  cashPaidCgst   Float @default(0)
  cashPaidSgst   Float @default(0)

  /// Date the cash was paid / the return was filed.
  paidOn        DateTime?
  /// Which bank / card the cash left from. Optional — the accountant may
  /// not know; the admin fills it in later.
  cashAccountId String?
  cashAccount   FinanceAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  /// Challan / ARN / any reference.
  reference     String?
  notes         String?

  cashTransactionId String?             @unique
  cashTransaction   FinanceTransaction? @relation("GstReturnCash", fields: [cashTransactionId], references: [id], onDelete: SetNull)
  itcTransactionId  String?             @unique
  itcTransaction    FinanceTransaction? @relation("GstReturnItc", fields: [itcTransactionId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("GstReturnCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

// ---------------------------------------------------------------------------
// Assets — what we bought and still own, and who has it right now
// ---------------------------------------------------------------------------

/// Something you can hold versus something that only exists as a
/// subscription / registration (a domain, a SaaS seat).
enum AssetKind {
  PHYSICAL
  DIGITAL
}

enum AssetStatus {
  /// Someone is using it.
  IN_USE
  /// Ours, with nobody — in the office cupboard.
  IN_STOCK
  /// Away for repair / replacement.
  REPAIR
  LOST
  SOLD
  SCRAPPED
}

/// One thing we bought and still own. The money stays in the ledger: an
/// asset points at the transaction that paid for it (`transactionId`) so
/// the same rupee is never recorded twice.
///
/// Where it is right now is NOT a column here — it is the open
/// `AssetAssignment` (the one with `toDate = null`). One source of truth,
/// the same rule the ledger follows with the bank statement.
model Asset {
  id         String    @id @default(cuid())
  name       String
  kind       AssetKind @default(PHYSICAL)
  /// Free label so the list groups sensibly: Laptop, Phone, SIM,
  /// Furniture, Domain, Subscription.
  category   String?
  /// Serial number, IMEI, SIM number, domain name — whatever identifies
  /// this exact one when two look alike.
  identifier String?

  purchaseDate  DateTime?
  /// What it cost, INR. Usually copied from the linked transaction.
  cost          Float?
  /// The ledger row that paid for it. One row buys one asset; buy three
  /// laptops on one invoice and the other two link to nothing, with the
  /// cost split by hand.
  transactionId String?             @unique
  transaction   FinanceTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  status   AssetStatus @default(IN_STOCK)
  /// Domains and subscriptions: when it has to be paid for again.
  renewsOn DateTime?
  notes    String?     @db.Text

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("AssetCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments AssetAssignment[]

  @@index([status])
  @@index([kind])
  @@index([productId])
  @@index([renewsOn])
  @@index([name])
}

/// Who had an asset, where, and between which dates. The row with
/// `toDate = null` is where the asset is right now; closing it and opening
/// a new one is how a handover is recorded, so the trail is never lost.
model AssetAssignment {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// One of the two is set: a panel user, or an outside party (a worker,
  /// a vendor holding it for repair). Neither set = back with the company.
  toUserId  String?
  toUser    User?         @relation("AssetHolderUser", fields: [toUserId], references: [id], onDelete: SetNull)
  toPartyId String?
  toParty   FinanceParty? @relation("AssetHolderParty", fields: [toPartyId], references: [id], onDelete: SetNull)

  /// Free text: "Office", "Anchal's home", "RBL service centre".
  location String?

  fromDate DateTime
  /// null = still with them.
  toDate   DateTime?
  note     String?

  createdById String
  createdBy   User   @relation("AssetAssignmentCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, toDate])
  @@index([toUserId])
  @@index([toPartyId])
}

// ---------------------------------------------------------------------------
// Month close — freeze a month once it has been checked against the bank
// ---------------------------------------------------------------------------

/// A month that has been reconciled and locked. While a month is closed,
/// writes dated inside it are refused, so a verified figure cannot drift.
/// An admin can reopen it; the balances recorded at close time act as a
/// tripwire if anything moved while it was open.
model MonthClose {
  id    String @id @default(cuid())
  /// YYYY-MM.
  month String @unique

  closedAt   DateTime @default(now())
  closedById String
  closedBy   User     @relation("MonthCloseCreator", fields: [closedById], references: [id])
  note       String?

  balances MonthCloseBalance[]
}

/// Each account's closing balance on the day the month was locked.
model MonthCloseBalance {
  id           String         @id @default(cuid())
  monthCloseId String
  monthClose   MonthClose     @relation(fields: [monthCloseId], references: [id], onDelete: Cascade)
  accountId    String
  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// `opening + ΣIN − ΣOUT` for every row up to the end of that month.
  balance      Float

  @@unique([monthCloseId, accountId])
  @@index([accountId])
}
